@page "/"

<h1>Week Plan</h1>

<p>
    Showing the week of <strong>@WeekStartDate.ToString("dddd d MMMM yyyy")</strong> to
    <strong>@WeekStartDate.AddDays(6).ToString("dddd d MMMM yyyy")</strong>.
</p>

<div class="week-plan__toolbar">
    <button class="btn btn--secondary" @onclick="GoToPreviousWeekAsync" disabled="@IsBusy">&laquo; Previous week</button>
    <button class="btn btn--secondary" @onclick="GoToNextWeekAsync" disabled="@IsBusy">Next week &raquo;</button>
    <button class="btn btn--primary" @onclick="GenerateWeekAsync" disabled="@IsBusy">
        @(IsBusy ? "Generating..." : "Generate random week")
    </button>
</div>

@if (ErrorMessage is not null)
{
    <div class="alert alert--error">@ErrorMessage</div>
}

@if (SuccessMessage is not null)
{
    <div class="alert alert--success">@SuccessMessage</div>
}

@if (DayPlans is null)
{
    <p>Loading week plan...</p>
}
else
{
    <div class="week-plan__tabs">
        <button class="week-plan__tab @(ActiveTab == WeekPlanTab.DayPlans ? "week-plan__tab--active" : "")"
                @onclick="@(() => ActiveTab = WeekPlanTab.DayPlans)">
            Day plans
        </button>
        <button class="week-plan__tab @(ActiveTab == WeekPlanTab.ShoppingList ? "week-plan__tab--active" : "")"
                @onclick="@(() => ActiveTab = WeekPlanTab.ShoppingList)">
            Shopping list
        </button>
    </div>

    @if (ActiveTab == WeekPlanTab.DayPlans)
    {
    @foreach (DayPlanResponseDto dayPlan in DayPlans)
    {
        <section class="week-plan__day">
            <h2>@dayPlan.Date.ToString("dddd d MMMM")</h2>

            @if (IsShortOnFibreOrPlants(dayPlan))
            {
                <button class="btn btn--link" @onclick="@(() => SuggestAllAdditionsAsync(dayPlan))" disabled="@DatesSuggestingAdditions.Contains(dayPlan.Date)">
                    @(DatesSuggestingAdditions.Contains(dayPlan.Date) ? "Thinking..." : "Suggest additions for all meals")
                </button>
            }

            <table class="table">
                <thead>
                    <tr>
                        <th>Slot</th>
                        <th>Meal</th>
                        <th class="table__value--numeric">Kcal</th>
                        <th class="table__value--numeric">Protein (g)</th>
                        <th class="table__value--numeric">Carbs (g)</th>
                        <th class="table__value--numeric">Fibre (g)</th>
                        <th class="table__value--numeric">Plants</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (DayPlanMealDto meal in dayPlan.Meals)
                    {
                        <tr>
                            <td>@meal.SlotKey</td>
                            <td>
                                @meal.Name
                            </td>
                            <td class="table__value--numeric">@meal.Kcal</td>
                            <td class="table__value--numeric">@meal.ProteinG</td>
                            <td class="table__value--numeric">@meal.CarbsG</td>
                            <td class="table__value--numeric">@meal.FibreG</td>
                            <td class="table__value--numeric">@meal.Plants</td>
                        </tr>
                        @if (SuggestionsByMealId.TryGetValue(meal.MealId, out MealAdditionSuggestionResult? suggestionResult))
                        {
                            <tr>
                                <td></td>
                                <td colspan="6" class="meal-suggestions">
                                    @if (suggestionResult.Errors.Count > 0)
                                    {
                                        <div class="alert alert--error">@string.Join(" ", suggestionResult.Errors)</div>
                                    }
                                    else if (suggestionResult.Suggestions.Count == 0)
                                    {
                                        <p>No additions suggested.</p>
                                    }
                                    else
                                    {
                                        <ul class="meal-suggestions__list">
                                            @foreach (SuggestedMealAddition suggestion in suggestionResult.Suggestions)
                                            {
                                                <li><strong>@suggestion.Amount @suggestion.Ingredient</strong> - @suggestion.Reason</li>
                                            }
                                        </ul>
                                    }
                                </td>
                            </tr>
                        }
                    }
                </tbody>
                <tfoot>
                    <tr>
                        <td colspan="2"><strong>Total</strong></td>
                        <td class="table__value--numeric">@dayPlan.Totals.Kcal</td>
                        <td class="table__value--numeric">@dayPlan.Totals.ProteinG</td>
                        <td class="table__value--numeric @CarbsCellModifierClass(dayPlan)">@dayPlan.Totals.CarbsG</td>
                        <td class="table__value--numeric">@dayPlan.Totals.FibreG</td>
                        <td class="table__value--numeric">@dayPlan.Totals.Plants</td>
                    </tr>
                    <tr>
                        <td colspan="2"><strong>Remaining vs. target</strong></td>
                        <td class="table__value--numeric">@dayPlan.Remaining.Kcal</td>
                        <td class="table__value--numeric">@dayPlan.Remaining.ProteinG</td>
                        <td class="table__value--numeric @CarbsCellModifierClass(dayPlan)">@dayPlan.Remaining.CarbsG</td>
                        <td class="table__value--numeric">@dayPlan.Remaining.FibreG</td>
                        <td class="table__value--numeric">@dayPlan.Remaining.Plants</td>
                    </tr>
                </tfoot>
            </table>
        </section>
    }
    }
    else
    {
        <section class="shopping-list">
            <h2>Weekly shopping list</h2>
            <p>Every ingredient needed for the meals planned this week, converted to grams and grouped into supermarket aisles.</p>

            @if (WeeklyShoppingList.Count == 0)
            {
                <p>No ingredients to show yet - meals in this week's plan don't have any ingredients recorded, or no meals have been planned.</p>
            }
            else
            {
                <button class="btn btn--primary" @onclick="GroupShoppingListAsync" disabled="@IsGroupingShoppingList">
                    @(IsGroupingShoppingList ? "Grouping..." : (GroupedShoppingList is null ? "Group by aisle" : "Regroup by aisle"))
                </button>

                @if (GroupingErrorMessage is not null)
                {
                    <div class="alert alert--error">@GroupingErrorMessage</div>
                }

                @if (GroupedShoppingList is not null)
                {
                    @foreach ((string category, List<GroupedIngredientDto> items) in GroupedShoppingList)
                    {
                        <h3 class="shopping-list__aisle">@category</h3>
                        <ul class="shopping-list__items">
                            @foreach (GroupedIngredientDto ingredient in items)
                            {
                                <li class="shopping-list__item">@ingredient.Grams g @ingredient.Name</li>
                            }
                        </ul>
                    }

                    <button class="btn btn--secondary" @onclick="CopyShoppingListToClipboardAsync">Copy shopping list</button>

                    @if (CopyStatusMessage is not null)
                    {
                        <span class="shopping-list__copy-status">@CopyStatusMessage</span>
                    }
                }
            }
        </section>
    }
}

@code {
    private enum WeekPlanTab { DayPlans, ShoppingList }

    /// <summary>The Monday that starts the week currently displayed on screen.</summary>
    private DateOnly WeekStartDate { get; set; } = StartOfWeekContaining(DateOnly.FromDateTime(DateTime.Today));

    /// <summary>One <see cref="DayPlanResponseDto"/> per day of the displayed week, in date order.</summary>
    private List<DayPlanResponseDto>? DayPlans { get; set; }

    /// <summary>Every ingredient needed this week, with matching name+unit combinations summed across all days.</summary>
    private List<DayPlanIngredientDto> WeeklyShoppingList { get; set; } = new();

    /// <summary>
    /// The most recent AI-grouped shopping list, keyed by supermarket aisle in the order the AI
    /// service defines them. Reset whenever the displayed week changes, since it's a snapshot of
    /// that week's ingredients.
    /// </summary>
    private List<(string Category, List<GroupedIngredientDto> Items)>? GroupedShoppingList { get; set; }

    private WeekPlanTab ActiveTab { get; set; } = WeekPlanTab.DayPlans;
    private bool IsBusy { get; set; }
    private bool IsGroupingShoppingList { get; set; }
    private string? ErrorMessage { get; set; }
    private string? SuccessMessage { get; set; }
    private string? CopyStatusMessage { get; set; }
    private string? GroupingErrorMessage { get; set; }

    /// <summary>The dates currently fetching bulk suggestions, so each day's button can show its own busy state.</summary>
    private HashSet<DateOnly> DatesSuggestingAdditions { get; set; } = new();

    /// <summary>The most recent AI-suggested additions per meal, keyed by meal ID.</summary>
    private Dictionary<Guid, MealAdditionSuggestionResult> SuggestionsByMealId { get; set; } = new();

    private const int DaysInWeek = 7;

    [Inject]
    private IWeekPlanGeneratorService WeekPlanGeneratorService { get; set; } = null!;

    [Inject]
    private IDayPlanService DayPlanService { get; set; } = null!;

    [Inject]
    private IIngredientGroupingService GroupingService { get; set; } = null!;

    [Inject]
    private IMealAdditionSuggestionService MealAdditionSuggestionService { get; set; } = null!;

    [Inject]
    private IJSRuntime JsRuntime { get; set; } = null!;

    protected override async Task OnInitializedAsync()
    {
        await LoadWeekAsync();
    }

    /// <summary>Reloads every day's plan (meals, totals, remaining-vs-target) for <see cref="WeekStartDate"/>.</summary>
    private async Task LoadWeekAsync()
    {
        List<DayPlanResponseDto> loadedDayPlans = new(DaysInWeek);

        for (int dayOffset = 0; dayOffset < DaysInWeek; dayOffset++)
        {
            DateOnly date = WeekStartDate.AddDays(dayOffset);
            loadedDayPlans.Add(await DayPlanService.GetDayPlanAsync(date, CancellationToken.None));
        }

        DayPlans = loadedDayPlans;
        WeeklyShoppingList = BuildWeeklyShoppingList(loadedDayPlans);
        GroupedShoppingList = null;
        GroupingErrorMessage = null;
        CopyStatusMessage = null;
        SuggestionsByMealId = new();
    }

    /// <summary>True once the day's running totals have fallen below either its fibre or plants target.</summary>
    private static bool IsShortOnFibreOrPlants(DayPlanResponseDto dayPlan)
    {
        return dayPlan.Remaining.FibreG > 0 || dayPlan.Remaining.Plants > 0;
    }

    /// <summary>
    /// Sends every meal in this day to the AI suggestion service, one at a time (the service shares
    /// a scoped <c>AppDbContext</c>, so calls can't run concurrently), along with how far the day is
    /// below its fibre/plant targets, and stores each result for display under its meal's row.
    /// </summary>
    private async Task SuggestAllAdditionsAsync(DayPlanResponseDto dayPlan)
    {
        DatesSuggestingAdditions.Add(dayPlan.Date);

        try
        {
            foreach (DayPlanMealDto meal in dayPlan.Meals)
            {
                MealAdditionSuggestionRequest request = new(
                    meal.MealId,
                    meal.Name,
                    meal.ZoeNotes,
                    meal.Notes,
                    meal.Ingredients,
                    Math.Max(0, dayPlan.Remaining.FibreG),
                    Math.Max(0, dayPlan.Remaining.Plants));

                MealAdditionSuggestionResult result = await MealAdditionSuggestionService.SuggestAdditionsAsync(request, CancellationToken.None);
                SuggestionsByMealId[meal.MealId] = result;
            }
        }
        finally
        {
            DatesSuggestingAdditions.Remove(dayPlan.Date);
        }
    }

    /// <summary>
    /// Sends the current week's shopping list to the AI grouping service, which converts every
    /// line to grams and assigns it to a supermarket aisle, then groups the result for display.
    /// </summary>
    private async Task GroupShoppingListAsync()
    {
        IsGroupingShoppingList = true;
        GroupingErrorMessage = null;
        CopyStatusMessage = null;

        try
        {
            IngredientGroupingResult result = await GroupingService.GroupIngredientsAsync(WeekStartDate, WeeklyShoppingList, CancellationToken.None);

            GroupedShoppingList = result.Ingredients
                .GroupBy(i => i.Category)
                .OrderBy(g => IngredientGroupingService.Categories.ToList().IndexOf(g.Key))
                .Select(g => (g.Key, g.OrderBy(i => i.Name).ToList()))
                .ToList();

            GroupingErrorMessage = result.Errors.Count == 0 ? null : string.Join(" ", result.Errors);
        }
        finally
        {
            IsGroupingShoppingList = false;
        }
    }

    /// <summary>
    /// Combines every ingredient across every meal in the week, summing the quantities of any
    /// ingredients that share the same name and unit (e.g. two different meals both calling for
    /// "g" of "Chicken breast" become a single combined shopping-list line).
    /// </summary>
    private static List<DayPlanIngredientDto> BuildWeeklyShoppingList(List<DayPlanResponseDto> dayPlans)
    {
        return dayPlans
            .SelectMany(d => d.Meals)
            .SelectMany(m => m.Ingredients)
            .GroupBy(i => (i.Name, i.Unit))
            .Select(g => new DayPlanIngredientDto(g.Key.Name, g.Sum(i => i.Quantity), g.Key.Unit))
            .OrderBy(i => i.Name)
            .ToList();
    }

    /// <summary>Copies the grouped shopping list as plain text, with an aisle heading per group, to the clipboard.</summary>
    private async Task CopyShoppingListToClipboardAsync()
    {
        string clipboardText = string.Join(
            Environment.NewLine + Environment.NewLine,
            (GroupedShoppingList ?? []).Select(g =>
                string.Join(Environment.NewLine, new[] { g.Category }.Concat(g.Items.Select(i => $"{i.Grams} g {i.Name}")))));

        try
        {
            await JsRuntime.InvokeVoidAsync("navigator.clipboard.writeText", clipboardText);
            CopyStatusMessage = "Copied to clipboard.";
        }
        catch (Exception)
        {
            CopyStatusMessage = "Could not access the clipboard - select the list above and copy it manually instead.";
        }
    }

    private async Task GoToPreviousWeekAsync()
    {
        WeekStartDate = WeekStartDate.AddDays(-DaysInWeek);
        ErrorMessage = null;
        SuccessMessage = null;
        await LoadWeekAsync();
    }

    private async Task GoToNextWeekAsync()
    {
        WeekStartDate = WeekStartDate.AddDays(DaysInWeek);
        ErrorMessage = null;
        SuccessMessage = null;
        await LoadWeekAsync();
    }

    /// <summary>
    /// Asks the generator to randomly fill every slot for every day of the displayed week, then
    /// reloads the week so the freshly generated meals are shown.
    /// </summary>
    private async Task GenerateWeekAsync()
    {
        IsBusy = true;
        ErrorMessage = null;
        SuccessMessage = null;

        try
        {
            GenerateWeekPlanRequest request = new(WeekStartDate);
            var (result, missingSlot, _) = await WeekPlanGeneratorService.GenerateWeekAsync(request, CancellationToken.None);

            if (result == GenerateWeekPlanResult.NoMealsAvailableForSlot)
            {
                ErrorMessage = $"Cannot generate this week: no meals have been uploaded yet for the '{missingSlot}' slot.";
                return;
            }

            await LoadWeekAsync();
            SuccessMessage = "A new random week has been generated.";
        }
        finally
        {
            IsBusy = false;
        }
    }

    /// <summary>Highlights a day's carbohydrate total/remaining in red once it has gone over target.</summary>
    private static string CarbsCellModifierClass(DayPlanResponseDto dayPlan)
    {
        return dayPlan.Totals.CarbsG > dayPlan.Targets.DailyCarbTargetG
            ? "table__value--over-target"
            : "table__value--under-target";
    }

    /// <summary>Finds the Monday on or before <paramref name="date"/>.</summary>
    private static DateOnly StartOfWeekContaining(DateOnly date)
    {
        int daysSinceMonday = ((int)date.DayOfWeek + 6) % 7;
        return date.AddDays(-daysSinceMonday);
    }
}
