@page "/meals"

<h1>Meals</h1>

<p>All meals currently in the database, grouped by slot. Use this page to add, edit, or delete individual meals one at a time - to bulk-load many meals at once, use the <a href="meals/upload">Upload Meals</a> page instead.</p>

<button class="btn btn--primary" @onclick="StartAddingNewMeal">Add a new meal</button>

@if (ErrorMessage is not null)
{
    <div class="alert alert--error">@ErrorMessage</div>
}

@if (IsFormVisible)
{
    <section class="meal-form">
        <h2>@(IsEditingExistingMeal ? "Edit meal" : "Add meal")</h2>

        <EditForm Model="FormModel" OnSubmit="SaveMealAsync" class="form">
            <div class="form__row">
                <label class="form__label" for="meal-name">Name</label>
                <InputText id="meal-name" class="form__control" @bind-Value="FormModel.Name" />
            </div>

            <div class="form__row">
                <label class="form__label" for="meal-slot">Slot</label>
                <InputSelect id="meal-slot" class="form__control" @bind-Value="FormModel.SlotKey">
                    @foreach (SlotDto slot in Slots ?? Enumerable.Empty<SlotDto>())
                    {
                        <option value="@slot.Key">@slot.DisplayName</option>
                    }
                </InputSelect>
            </div>

            <div class="form__row">
                <label class="form__label" for="meal-kcal">Kcal</label>
                <InputNumber id="meal-kcal" class="form__control" @bind-Value="FormModel.Kcal" />
            </div>

            <div class="form__row">
                <label class="form__label" for="meal-protein">Protein (g)</label>
                <InputNumber id="meal-protein" class="form__control" @bind-Value="FormModel.ProteinG" />
            </div>

            <div class="form__row">
                <label class="form__label" for="meal-carbs">Carbs (g)</label>
                <InputNumber id="meal-carbs" class="form__control" @bind-Value="FormModel.CarbsG" />
            </div>

            <div class="form__row">
                <label class="form__label" for="meal-fibre">Fibre (g)</label>
                <InputNumber id="meal-fibre" class="form__control" @bind-Value="FormModel.FibreG" />
            </div>

            <div class="form__row">
                <label class="form__label" for="meal-plants">Plant points</label>
                <InputNumber id="meal-plants" class="form__control" @bind-Value="FormModel.Plants" />
            </div>

            <div class="form__row">
                <label class="form__label" for="meal-mfname">MyFitnessPal name</label>
                <InputText id="meal-mfname" class="form__control" @bind-Value="FormModel.MfName" />
            </div>

            <div class="form__row">
                <label class="form__label" for="meal-zoe-notes">Zoe notes</label>
                <InputTextArea id="meal-zoe-notes" class="form__control" @bind-Value="FormModel.ZoeNotes" />
            </div>

            <div class="form__row">
                <label class="form__label" for="meal-notes">Notes</label>
                <InputTextArea id="meal-notes" class="form__control" @bind-Value="FormModel.Notes" />
            </div>

            <h3>Ingredients</h3>
            <table class="ingredient-table">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Quantity</th>
                        <th>Unit</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (MealIngredientFormModel ingredient in FormModel.Ingredients)
                    {
                        <tr>
                            <td><InputText class="ingredient-table__input" @bind-Value="ingredient.Name" placeholder="e.g. Chicken breast" /></td>
                            <td><InputNumber class="ingredient-table__input" @bind-Value="ingredient.Quantity" /></td>
                            <td><InputText class="ingredient-table__input" @bind-Value="ingredient.Unit" placeholder="e.g. g" /></td>
                            <td><button type="button" class="btn btn--secondary" @onclick="() => RemoveIngredientRow(ingredient)">Remove</button></td>
                        </tr>
                    }
                </tbody>
            </table>
            <button type="button" class="btn btn--secondary" @onclick="AddIngredientRow">Add ingredient</button>

            @if (FormValidationErrors.Count > 0)
            {
                <ul class="form__errors">
                    @foreach (string validationError in FormValidationErrors)
                    {
                        <li>@validationError</li>
                    }
                </ul>
            }

            <button type="submit" class="btn btn--primary">Save meal</button>
            <button type="button" class="btn btn--secondary" @onclick="CancelEditing">Cancel</button>
        </EditForm>
    </section>
}

@if (Meals is null)
{
    <p>Loading meals...</p>
}
else if (Meals.Count == 0)
{
    <p>No meals have been added yet.</p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Slot</th>
                <th>Name</th>
                <th>MyFitnessPal name</th>
                <th class="table__value--numeric">Kcal</th>
                <th class="table__value--numeric">Protein (g)</th>
                <th class="table__value--numeric">Carbs (g)</th>
                <th class="table__value--numeric">Fibre (g)</th>
                <th class="table__value--numeric">Plants</th>
                <th>Ingredients</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (MealDto meal in Meals.OrderBy(m => m.SlotKey).ThenBy(m => m.Name))
            {
                <tr>
                    <td>@meal.SlotKey</td>
                    <td>@meal.Name</td>
                    <td>@meal.MfName</td>
                    <td class="table__value--numeric">@meal.Kcal</td>
                    <td class="table__value--numeric">@meal.ProteinG</td>
                    <td class="table__value--numeric">@meal.CarbsG</td>
                    <td class="table__value--numeric">@meal.FibreG</td>
                    <td class="table__value--numeric">@meal.Plants</td>
                    <td>@meal.Ingredients.Count</td>
                    <td>
                        <button class="btn btn--secondary" @onclick="() => StartEditingMeal(meal)">Edit</button>
                        <button class="btn btn--danger" @onclick="() => DeleteMealAsync(meal.MealId)">Delete</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private List<MealDto>? Meals { get; set; }
    private List<SlotDto>? Slots { get; set; }
    private MealFormModel FormModel { get; set; } = new();
    private bool IsFormVisible { get; set; }
    private bool IsEditingExistingMeal { get; set; }
    private string? ErrorMessage { get; set; }
    private List<string> FormValidationErrors { get; set; } = new();

    [Inject]
    private IMealsService MealsService { get; set; } = null!;

    [Inject]
    private ISlotsService SlotsService { get; set; } = null!;

    [Inject]
    private FluentValidation.IValidator<UpsertMealRequest> MealValidator { get; set; } = null!;

    protected override async Task OnInitializedAsync()
    {
        Slots = (await SlotsService.GetSlotsAsync(CancellationToken.None)).OrderBy(s => s.SortOrder).ToList();
        await ReloadMealsAsync();
    }

    private async Task ReloadMealsAsync()
    {
        Meals = (await MealsService.GetMealsAsync(CancellationToken.None)).ToList();
    }

    private void StartAddingNewMeal()
    {
        FormModel = new MealFormModel { MealId = Guid.NewGuid(), SlotKey = Slots?.FirstOrDefault()?.Key ?? SlotKey.Breakfast };
        IsEditingExistingMeal = false;
        IsFormVisible = true;
        FormValidationErrors.Clear();
        ErrorMessage = null;
    }

    private void StartEditingMeal(MealDto meal)
    {
        FormModel = new MealFormModel
        {
            MealId = meal.MealId,
            Name = meal.Name,
            SlotKey = meal.SlotKey,
            Kcal = meal.Kcal,
            ProteinG = meal.ProteinG,
            CarbsG = meal.CarbsG,
            FibreG = meal.FibreG,
            Plants = meal.Plants,
            MfName = meal.MfName,
            ZoeNotes = meal.ZoeNotes,
            Notes = meal.Notes,
            Ingredients = meal.Ingredients
                .Select(i => new MealIngredientFormModel { Name = i.Name, Quantity = i.Quantity, Unit = i.Unit })
                .ToList()
        };
        IsEditingExistingMeal = true;
        IsFormVisible = true;
        FormValidationErrors.Clear();
        ErrorMessage = null;
    }

    private void CancelEditing()
    {
        IsFormVisible = false;
        FormValidationErrors.Clear();
    }

    private void AddIngredientRow()
    {
        FormModel.Ingredients.Add(new MealIngredientFormModel());
    }

    private void RemoveIngredientRow(MealIngredientFormModel ingredient)
    {
        FormModel.Ingredients.Remove(ingredient);
    }

    private async Task SaveMealAsync()
    {
        // Blank ingredient rows (left over from "Add ingredient" without filling them in) are
        // dropped here rather than rejected by validation, since users often add a row and then
        // change their mind.
        List<UpsertMealIngredientRequest> ingredients = FormModel.Ingredients
            .Where(i => !string.IsNullOrWhiteSpace(i.Name))
            .Select(i => new UpsertMealIngredientRequest(i.Name, i.Quantity, i.Unit))
            .ToList();

        UpsertMealRequest request = new(
            FormModel.MealId,
            FormModel.Name,
            FormModel.SlotKey,
            FormModel.Kcal,
            FormModel.ProteinG,
            FormModel.CarbsG,
            FormModel.FibreG,
            FormModel.Plants,
            FormModel.ZoeNotes,
            FormModel.MfName,
            FormModel.Notes,
            ingredients);

        FluentValidation.Results.ValidationResult validationResult = await MealValidator.ValidateAsync(request);
        if (!validationResult.IsValid)
        {
            FormValidationErrors = validationResult.Errors.Select(e => e.ErrorMessage).ToList();
            return;
        }

        var (result, _) = await MealsService.UpsertMealAsync(request, CancellationToken.None);
        if (result == UpsertMealResult.InvalidSlot)
        {
            FormValidationErrors = new List<string> { "The selected slot no longer exists." };
            return;
        }

        IsFormVisible = false;
        FormValidationErrors.Clear();
        await ReloadMealsAsync();
    }

    private async Task DeleteMealAsync(Guid mealId)
    {
        ErrorMessage = null;
        DeleteResult result = await MealsService.DeleteMealAsync(mealId, CancellationToken.None);
        if (result == DeleteResult.NotFound)
        {
            ErrorMessage = "That meal has already been removed.";
        }

        await ReloadMealsAsync();
    }

    /// <summary>
    /// Mutable stand-in for <see cref="UpsertMealRequest"/> so its fields can be two-way bound by
    /// Blazor's &lt;InputText&gt;/&lt;InputNumber&gt; components, which need settable properties
    /// rather than the init-only properties a record's primary constructor produces.
    /// </summary>
    private sealed class MealFormModel
    {
        public Guid MealId { get; set; }
        public string Name { get; set; } = string.Empty;
        public SlotKey SlotKey { get; set; }
        public int Kcal { get; set; }
        public int ProteinG { get; set; }
        public int CarbsG { get; set; }
        public int FibreG { get; set; }
        public int Plants { get; set; }
        public string MfName { get; set; } = string.Empty;
        public string? ZoeNotes { get; set; }
        public string? Notes { get; set; }
        public List<MealIngredientFormModel> Ingredients { get; set; } = new();
    }

    /// <summary>Mutable stand-in for <see cref="UpsertMealIngredientRequest"/>, for the same two-way binding reason as <see cref="MealFormModel"/>.</summary>
    private sealed class MealIngredientFormModel
    {
        public string Name { get; set; } = string.Empty;
        public decimal Quantity { get; set; }
        public string? Unit { get; set; }
    }
}
