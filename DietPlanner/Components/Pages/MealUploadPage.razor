@page "/meals/upload"

<h1>Upload Meals</h1>

<p>
    Bulk-load meals from a CSV file. The first row must be a header row containing exactly these
    column names (any order): <code>Name, SlotKey, Kcal, ProteinG, CarbsG, FibreG, Plants, MfName,
    ZoeNotes, Notes</code>. <code>SlotKey</code> must be one of:
    @string.Join(", ", Enum.GetNames<SlotKey>()). Uploading a meal whose Name and SlotKey already
    exist in the database updates that meal's macros instead of creating a duplicate.
</p>

<p>
    You may also include an optional <code>Ingredients</code> column. List each ingredient
    separated by <code>;</code>, with each one in <code>Quantity|Unit|Name</code> form (leave Unit
    blank for countable items, e.g. <code>1||Egg</code>) - for example:
    <code>200|g|Chicken breast;1||Egg;2|tbsp|Olive oil</code>. If the column is present it replaces
    any existing ingredients for matched meals; omit it entirely to leave existing ingredients
    untouched.
</p>

<div class="form__row">
    <label class="form__label" for="csv-file-input">Choose CSV file</label>
    <InputFile id="csv-file-input" class="form__control" OnChange="OnCsvFileSelected" accept=".csv" disabled="@IsUploading" />
    @if (SelectedCsvFile is not null)
    {
        <p>Selected: @SelectedCsvFile.Name</p>
    }
    <button type="button" class="btn btn--primary" disabled="@(SelectedCsvFile is null || IsUploading)" @onclick="UploadCsvAsync">
        Upload CSV
    </button>
</div>

<h2>Or upload a PDF</h2>

<p>
    Upload a PDF (recipe sheet, meal plan, etc) and an AI model will read it and extract meals
    automatically. Works best with PDFs whose text can be selected/copied (scanned image-only PDFs
    won't have extractable text).
</p>

<div class="form__row">
    <label class="form__label" for="pdf-file-input">Choose PDF file</label>
    <InputFile id="pdf-file-input" class="form__control" OnChange="OnPdfFileSelected" accept=".pdf" disabled="@IsUploading" />
    @if (SelectedPdfFile is not null)
    {
        <p>Selected: @SelectedPdfFile.Name</p>
    }
    <button type="button" class="btn btn--primary" disabled="@(SelectedPdfFile is null || IsUploading)" @onclick="UploadPdfAsync">
        Upload PDF
    </button>
</div>

@if (IsUploading)
{
    <p>Uploading and importing @UploadingFileName...</p>
}

@if (ErrorMessage is not null)
{
    <div class="alert alert--error">
        <p>Something went wrong: @ErrorMessage</p>
    </div>
}

@if (ImportResult is not null)
{
    <div class="alert @(ImportResult.RowErrors.Count > 0 ? "alert--error" : "alert--success")">
        <p>
            Inserted @ImportResult.InsertedCount new meal(s) and updated @ImportResult.UpdatedCount
            existing meal(s).
        </p>

        @if (ImportResult.RowErrors.Count > 0)
        {
            <p>The following rows could not be imported and were skipped:</p>
            <ul>
                @foreach (string rowError in ImportResult.RowErrors)
                {
                    <li>@rowError</li>
                }
            </ul>
        }
    </div>
}

@code {
    private const long MaxCsvUploadSizeBytes = 5 * 1024 * 1024;
    private const long MaxPdfUploadSizeBytes = 25 * 1024 * 1024;

    private bool IsUploading { get; set; }
    private MealImportResult? ImportResult { get; set; }
    private string? ErrorMessage { get; set; }
    private string? UploadingFileName { get; set; }
    private IBrowserFile? SelectedCsvFile { get; set; }
    private IBrowserFile? SelectedPdfFile { get; set; }

    [Inject]
    private IMealImportService MealImportService { get; set; } = null!;

    [Inject]
    private IMealPdfImportService MealPdfImportService { get; set; } = null!;

    private void OnCsvFileSelected(InputFileChangeEventArgs changeEventArgs)
    {
        SelectedCsvFile = changeEventArgs.File;
        ImportResult = null;
        ErrorMessage = null;
    }

    private void OnPdfFileSelected(InputFileChangeEventArgs changeEventArgs)
    {
        SelectedPdfFile = changeEventArgs.File;
        ImportResult = null;
        ErrorMessage = null;
    }

    private async Task UploadCsvAsync()
    {
        if (SelectedCsvFile is null)
        {
            return;
        }

        UploadingFileName = SelectedCsvFile.Name;
        IsUploading = true;
        ImportResult = null;
        ErrorMessage = null;

        try
        {
            await using Stream uploadedFileStream = SelectedCsvFile.OpenReadStream(MaxCsvUploadSizeBytes);
            ImportResult = await MealImportService.ImportFromCsvAsync(uploadedFileStream, CancellationToken.None);
        }
        catch (Exception ex)
        {
            LogCsvImportFailed(ex, SelectedCsvFile.Name);
            ErrorMessage = ex.Message;
        }
        finally
        {
            IsUploading = false;
            UploadingFileName = null;
        }
    }

    private async Task UploadPdfAsync()
    {
        if (SelectedPdfFile is null)
        {
            return;
        }

        UploadingFileName = SelectedPdfFile.Name;
        IsUploading = true;
        ImportResult = null;
        ErrorMessage = null;

        try
        {
            await using Stream uploadedFileStream = SelectedPdfFile.OpenReadStream(MaxPdfUploadSizeBytes);
            ImportResult = await MealPdfImportService.ImportFromPdfAsync(uploadedFileStream, CancellationToken.None);
        }
        catch (Exception ex)
        {
            LogPdfImportFailed(ex, SelectedPdfFile.Name);
            ErrorMessage = ex.Message;
        }
        finally
        {
            IsUploading = false;
            UploadingFileName = null;
        }
    }
}
